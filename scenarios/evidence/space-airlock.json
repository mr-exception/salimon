{
  "setup": {"scenario": "open-space", "seed": 0, "step_ms": 16},
  "timeout_ms": 120000,
  "steps": [
    {"assert": {"path": "ship.nearby_body", "equals": null}},
    {"assert": {"path": "ship.flight_state", "equals": "Flying"}},
    {"action": {"op": "interact"}},
    {"action": {"op": "key", "key": "backward", "pressed": true}},
    {"action": {"op": "step", "frames": 110}},
    {"action": {"op": "key", "key": "backward", "pressed": false}},
    {"action": {"op": "key", "key": "right", "pressed": true}},
    {"action": {"op": "step", "frames": 36}},
    {"action": {"op": "key", "key": "right", "pressed": false}},
    {"assert": {"path": "interaction", "equals": "exit_door"}},
    {"action": {"op": "key", "key": "backward", "pressed": true}},
    {"action": {"op": "step", "frames": 40}},
    {"action": {"op": "key", "key": "backward", "pressed": false}},
    {"assert": {"path": "player.location", "equals": "InsideShip"}},
    {"assert": {"path": "player.ship_local_eye_position_meters.0", "approx": -7.24, "tolerance": 0.001}},
    {"action": {"op": "interact"}},
    {"assert": {"path": "ship.door_state", "equals": "Open"}},
    {"action": {"op": "step", "frames": 45}},
    {"action": {"op": "key", "key": "backward", "pressed": true}},
    {"action": {"op": "step", "frames": 40}},
    {"action": {"op": "key", "key": "backward", "pressed": false}},
    {"assert": {"path": "player.location", "equals": "Space"}},
    {"screenshot": "space-exit"},
    {"assert": {"path": "player.ship_local_eye_position_meters.0", "lt": -8.2}},
    {"assert": {"path": "player.ship_local_eye_position_meters.1", "approx": 1.9973118279569892, "tolerance": 0.001}},
    {"action": {"op": "step", "frames": 30}},
    {"assert": {"path": "player.ship_local_eye_position_meters.1", "approx": 1.9973118279569892, "tolerance": 0.001}},
    {"assert": {"path": "interaction", "equals": "exit_door"}},
    {"action": {"op": "interact"}},
    {"assert": {"path": "ship.door_state", "equals": "Closed"}},
    {"action": {"op": "key", "key": "forward", "pressed": true}},
    {"action": {"op": "step", "frames": 60}},
    {"action": {"op": "key", "key": "forward", "pressed": false}},
    {"assert": {"path": "player.location", "equals": "Space"}},
    {"screenshot": "space-closed-door"},
    {"assert": {"path": "player.ship_local_eye_position_meters.0", "approx": -8.16, "tolerance": 0.001}},
    {"action": {"op": "interact"}},
    {"assert": {"path": "ship.door_state", "equals": "Open"}},
    {"action": {"op": "step", "frames": 45}},
    {"action": {"op": "key", "key": "forward", "pressed": true}},
    {"action": {"op": "step", "frames": 45}},
    {"action": {"op": "key", "key": "forward", "pressed": false}},
    {"assert": {"path": "player.location", "equals": "InsideShip"}},
    {"screenshot": "space-reentry"},
    {"assert": {"path": "player.local_ship_position_meters.0", "gt": -7.0}},
    {"action": {"op": "interact"}},
    {"assert": {"path": "ship.door_state", "equals": "Closed"}},
    {"action": {"op": "key", "key": "backward", "pressed": true}},
    {"action": {"op": "step", "frames": 70}},
    {"action": {"op": "key", "key": "backward", "pressed": false}},
    {"assert": {"path": "player.location", "equals": "InsideShip"}},
    {"screenshot": "space-interior-closed-door"},
    {"assert": {"path": "player.ship_local_eye_position_meters.0", "approx": -7.24, "tolerance": 0.001}},
    {"assert": {"path": "ship.flight_state", "equals": "Flying"}}
  ]
}
