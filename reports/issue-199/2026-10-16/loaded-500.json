{
  "setup": {
    "scenario": "orbit-earth",
    "seed": 200,
    "step_ms": 16,
    "fragment_count": 500,
    "fragment_layout": "onboard"
  },
  "timeout_ms": 300000,
  "steps": [
    {
      "assert": {
        "path": "world.fragment_count",
        "equals": 500
      }
    },
    {
      "assert": {
        "path": "ship.total_mass_kg",
        "approx": 100016,
        "tolerance": 1e-06
      }
    },
    {
      "action": {
        "op": "landing"
      }
    },
    {
      "assert": {
        "path": "ship.flight_state",
        "equals": "AssistedLanding { body: Earth }"
      }
    },
    {
      "action": {
        "op": "step",
        "frames": 600
      },
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "step",
        "frames": 200
      },
      "timeout_ms": 120000
    },
    {
      "assert": {
        "path": "ship.flight_state",
        "equals": "Landed { body: Earth }"
      }
    },
    {
      "assert": {
        "path": "world.fragment_count",
        "equals": 500
      }
    },
    {
      "assert": {
        "path": "ship.total_mass_kg",
        "approx": 100016,
        "tolerance": 1e-06
      }
    },
    {
      "screenshot": "loaded-500-landed"
    },
    {
      "action": {
        "op": "landing"
      }
    },
    {
      "assert": {
        "path": "ship.flight_state",
        "equals": "AssistedTakeoff { body: Earth }"
      }
    },
    {
      "action": {
        "op": "step",
        "frames": 400
      },
      "timeout_ms": 120000
    },
    {
      "assert": {
        "path": "ship.flight_state",
        "equals": "Flying"
      }
    },
    {
      "assert": {
        "path": "ship.speed_meters_per_second",
        "gt": 0
      }
    },
    {
      "assert": {
        "path": "ship.thruster_percentage",
        "equals": 0
      }
    },
    {
      "assert": {
        "path": "world.fragment_count",
        "equals": 500
      }
    },
    {
      "assert": {
        "path": "ship.total_mass_kg",
        "approx": 100016,
        "tolerance": 1e-06
      }
    },
    {
      "screenshot": "loaded-500-takeoff"
    }
  ]
}
