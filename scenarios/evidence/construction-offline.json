{
  "setup": {
    "scenario": "construction-build",
    "seed": 550,
    "step_ms": 16
  },
  "timeout_ms": 600000,
  "steps": [
    {
      "assert": {
        "path": "construction.projects.0.work.completed",
        "equals": false
      },
      "timeout_ms": 120000
    },
    {
      "screenshot": "ready-for-intake",
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "key",
        "key": "interact",
        "pressed": true
      },
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "key",
        "key": "interact",
        "pressed": false
      },
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "step",
        "frames": 312
      },
      "timeout_ms": 120000
    },
    {
      "assert": {
        "path": "construction.projects.0.funding.progress_ppm",
        "equals": 499200
      },
      "timeout_ms": 120000
    },
    {
      "screenshot": "half-built",
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "offline_resume",
        "seconds": 6
      },
      "timeout_ms": 120000
    },
    {
      "assert": {
        "path": "construction.projects.0.work.completed",
        "equals": true
      },
      "timeout_ms": 120000
    },
    {
      "assert": {
        "path": "construction.offline_clock.watermark",
        "equals": 106
      },
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "key",
        "key": "build",
        "pressed": true
      },
      "timeout_ms": 120000
    },
    {
      "action": {
        "op": "key",
        "key": "build",
        "pressed": false
      },
      "timeout_ms": 120000
    },
    {
      "screenshot": "completed-after-verified-resume",
      "timeout_ms": 120000
    }
  ]
}
