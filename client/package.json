{
  "name": "salimon-navigation-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/*.test.ts scripts/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:negative": "node scripts/negative-navigation.mjs",
    "test:visual": "playwright test --project=navigation-captures",
    "test:visual:negative": "node scripts/negative-visual.mjs && node scripts/negative-panoramic.mjs",
    "test:visual:approval": "node --experimental-strip-types scripts/baseline-approval.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
