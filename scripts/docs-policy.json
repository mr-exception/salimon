{
  "include": [
    "AGENTS.md",
    "README.md",
    "docs/**/*.md",
    "client/*/*.md",
    "scripts/*.md"
  ],
  "exclude": [],
  "required_paths": [
    "docs/documentation-maintenance.md",
    "docs/technical-architecture.md",
    "docs/maintenance-map.md",
    "client/universe/architecture.md",
    "client/universe/invariants.md"
  ],
  "stale_rules": [
    {
      "paths": [
        "client/universe/*.md"
      ],
      "pattern": "runtime generates random planet seeds",
      "reason": "canonical planet definitions must be published, not generated by runtime"
    }
  ],
  "json_examples": [
    {
      "path": "client/universe/fixtures/schema-v1.json",
      "fields": {
        "format": "salimon.universe.catalog",
        "schema_version": 1
      }
    }
  ],
  "no_impact": [],
  "baseline": []
}
