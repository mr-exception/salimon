    {"action": {"op": "key", "key": "left", "pressed": false}},
    {"assert": {"path": "ship.velocity_meters_per_second.0", "approx": -800, "tolerance": 1e-07}},
    {"assert": {"path": "ship.navigation.angle_degrees", "gt": 170}},
    {"action": {"op": "key", "key": "thruster_down", "pressed": true}},
    {"action": {"op": "step", "frames": 100}},
    {"action": {"op": "key", "key": "thruster_down", "pressed": false}},
    {"assert": {"path": "ship.thruster_percentage", "equals": -17}},
    {"action": {"op": "interact"}},
    {"assert": {"path": "ship.cockpit_control_active", "equals": false}},
    {"assert": {"path": "ship.thruster_percentage", "equals": -17}},
    {"action": {"op": "step", "frames": 1}},
    {"assert": {"path": "ship.speed_meters_per_second", "gt": 800}}
  ]
}
